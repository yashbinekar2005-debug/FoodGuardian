# FoodGuardian Environment Variables Configuration

# Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000

# Database
# Production / Docker Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/foodguardian
# For local dev / test without Docker running, SQLite can be used: sqlite+aiosqlite:///./foodguardian.db
DATABASE_URL=sqlite+aiosqlite:///./foodguardian.db
SYNC_DATABASE_URL=sqlite:///./foodguardian.db

# Redis Caching (optional in local dev, in-memory cache used as fallback)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
API_SECRET=dev-secret-key-change-in-production-min-32-chars-long
JWT_SECRET=dev-jwt-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma separated origins, or * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,chrome-extension://*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
