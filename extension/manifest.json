{
  "manifest_version": 3,
  "name": "FoodGuardian - Food Safety & Ingredient Intelligence",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "Analyzes packaged-food products on e-commerce websites with additive decoding, nutrition analysis, and India vs EU regulatory comparisons.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://amazon.in/*",
    "https://*.amazon.com/*",
    "https://amazon.com/*",
    "https://*.bigbasket.com/*",
    "https://bigbasket.com/*",
    "https://*.blinkit.com/*",
    "https://blinkit.com/*",
    "https://*.zepto.com/*",
    "https://zepto.com/*",
    "https://*.swiggy.com/*",
    "https://swiggy.com/*",
    "https://*.jiomart.com/*",
    "https://jiomart.com/*",
    "https://*.flipkart.com/*",
    "https://flipkart.com/*",
    "https://*.flixcart.com/*",
    "https://flixcart.com/*",
    "https://*.bbassets.com/*",
    "https://bbassets.com/*",
    "https://*.grofers.com/*",
    "https://grofers.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://amazon.in/*",
        "https://*.amazon.com/*",
        "https://amazon.com/*",
        "https://*.bigbasket.com/*",
        "https://bigbasket.com/*",
        "https://*.blinkit.com/*",
        "https://blinkit.com/*",
        "https://*.zepto.com/*",
        "https://zepto.com/*",
        "https://*.swiggy.com/*",
        "https://swiggy.com/*",
        "https://*.jiomart.com/*",
        "https://jiomart.com/*",
        "https://*.flipkart.com/*",
        "https://flipkart.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FoodGuardian",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
